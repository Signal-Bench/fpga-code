# Generated by the icestorm build flow (yosys/nextpnr/icepack) -- reproducible via `make build`
*.blif
*.asc
*.bin
*.json

# Simulation outputs (iverilog/vvp/gtkwave) -- reproducible via `make sim` / `make wave`
*.out
*.vcd

# Timing / synthesis / PnR reports and logs
*.rpt
*.log

# Compiled host tool
tools/send_pattern

# Vendored reference repos (each has its own git history, tracked separately)
UPduino-v3.0/
ice40_ultraplus_examples/
up5k/

# lattice docs
ice_docs/

# Vendor datasheets and standards -- local-only reference, not redistributable.
# The ISO 11898-1 copies are institution-licensed and marked no-further-reproduction,
# and the folder is ~54 MB of PDFs against a few hundred KB of RTL.
docs/

# Editor / agent scratch
.codex
